map_hash_bucket_size 128;
# Single-origin gateway. ${ANON_KEY}, ${SUPABASE_PUBLISHABLE_KEY} and
# ${FRONTEND_UPSTREAM} are substituted from the environment by the nginx image's
# own entrypoint, so no key is stored in this file.
#
# The browser sends the publishable key (safe to ship in a bundle). The gateway
# exchanges it for the internal anon token, which is what GoTrue, PostgREST and
# Storage verify. A signed-in user's own token is passed through untouched, so
# row-level security and role checks still decide everything.

map $http_authorization $auth_header {
    default                              $http_authorization;
    ""                                   "Bearer ${ANON_KEY}";
    "Bearer ${SUPABASE_PUBLISHABLE_KEY}" "Bearer ${ANON_KEY}";
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 8000;
    server_name _;

    # Profile photos are limited to 2 MB by the bucket; leave headroom.
    client_max_body_size 50m;
    # Access tokens make for large Authorization headers.
    large_client_header_buffers 4 32k;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 10s;
    proxy_read_timeout 180s;
    proxy_send_timeout 180s;

    location /auth/v1/ {
        proxy_set_header Authorization $auth_header;
        proxy_pass http://auth:9999/;
    }

    location /rest/v1/ {
        proxy_set_header Authorization $auth_header;
        proxy_pass http://rest:3000/;
    }

    location /storage/v1/ {
        proxy_set_header Authorization $auth_header;
        proxy_set_header X-Forwarded-Path /storage/v1;
        proxy_pass http://storage:5000/;
    }

    location /functions/v1/ {
        # Passed through unchanged: create-account verifies the caller's own
        # token with auth.getUser() before doing anything privileged.
        proxy_set_header Authorization $http_authorization;
        proxy_buffering off;
        proxy_pass http://functions:9000/;
    }

    # Everything else is the application itself (dev server or built files).
    location / {
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_pass http://${FRONTEND_UPSTREAM};
    }
}
