# Reference only. The real .env is GENERATED with random secrets by:
#
#   bash docker/scripts/init-env.sh
#
# Never commit a filled-in .env, and never send it to anyone except as part of
# a backup you keep private.

# ---- Where the application is served -------------------------------------
# Change all three together if the port is already taken.
APP_PORT=8000
PUBLIC_URL=http://localhost:8000
VITE_SUPABASE_URL=http://localhost:8000

# Mailpit web interface (password-recovery emails)
MAIL_UI_PORT=8025

# frontend:5173 (dev server) or frontend-prod:8080 (built site)
FRONTEND_UPSTREAM=frontend:5173

# ---- Keys ----------------------------------------------------------------
# Browser-safe key: this one is meant to be in the JavaScript bundle.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_GENERATED

# Internal only. Never copy these into a VITE_ variable or frontend code.
POSTGRES_PASSWORD=GENERATED
JWT_SECRET=GENERATED
JWT_EXPIRY=3600
ANON_KEY=GENERATED
SERVICE_ROLE_KEY=GENERATED
